rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, delete: if false;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'nicknameLower'])
        && !request.resource.data.keys().hasAny(['managementId', 'admin']);
    }

    match /privateProfiles/{uid} {
      allow read, write: if false;
    }

    match /boxSecrets/{boxId} {
      allow read, write: if false;
    }

    match /adminClaims/{uid} {
      allow read, write: if false;
    }

    match /downloadTickets/{token} {
      allow read, write: if false;
    }

    match /uploads/{uploadId} {
      allow read, write: if false;
    }

    match /boxes/{boxId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    match /items/{itemId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/boxes/$(resource.data.boxId))
        && request.auth.uid in get(/databases/$(database)/documents/boxes/$(resource.data.boxId)).data.memberUids;
      allow write: if false;
    }

    match /stats/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /requests/{id} {
      allow read, write: if false;
    }

    match /counted/{id} {
      allow read, write: if false;
    }

    match /pairingAttempts/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
