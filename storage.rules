rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{file} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /thumbs/{file} {
      allow read: if false;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
